# Database
# Local: postgresql://42route:42route123@localhost:5432/42route_db?sslmode=disable
# Neon pooler: .../neondb?sslmode=require&pgbouncer=true&connect_timeout=15
DATABASE_URL=postgresql://user:password@localhost:5432/42routedb?sslmode=disable

# Application
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Applied to both HTTP and Socket.IO. Use comma-separated explicit origins in production.
CORS_ORIGINS=*

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES=1h

# QR Code (AES-ECB, mesma chave usada pelas apps que ja emitem/leem os QRs fisicos)
# Deve ter exactamente 16, 24 ou 32 bytes (AES-128/192/256)
QR_SECRET_KEY=change_me_16bytes
QR_BOARDING_TTL_SECONDS=45

# 42 Intra OAuth2
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret

# Swagger Documentation HTTP Basic Auth
SWAGGER_USER=Admin42
SWAGGER_PASSWORD=4FutureWillBeBrilliant2DoBungle