# ====================================================
# 42Route API - Exemplo de Configuração de Produção
# ====================================================

# Database de Produção (Temps / Servidor)
DATABASE_URL=postgresql://user:password@host.docker.internal:5442/database_name?sslmode=disable

# Aplicação
PORT=3000
NODE_ENV=production
APP_URL=https://api42routes.42luanda.com
CORS_ORIGINS=https://backoffice.42luanda.com,https://api42routes.42luanda.com

# Autenticação JWT
JWT_SECRET=your_super_secret_production_jwt_key
JWT_EXPIRES=7d

# QR Code (16, 24 ou 32 bytes)
QR_SECRET_KEY=your_16_bytes_key_here
QR_BOARDING_TTL_SECONDS=45

# 42 Intra OAuth2
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret

# Swagger Documentation (Protegido por HTTP Basic Auth)
SWAGGER_USER=Admin42
SWAGGER_PASSWORD=your_secure_swagger_password
